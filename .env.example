# ── Ortak anahtarlar (tüm firmalar için tek) ─────────────────────────
# Bu dosyayı .env olarak kopyala ve doldur. .env asla commit edilmez.

# Anthropic (içerik planı + metinler) — https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Telifsiz, yüksek çözünürlüklü stok fotoğraf (şehir, yaşam/detay) — ücretsiz
# İndirme: uv run python -m app.stock --client <firma>
# Unsplash: https://unsplash.com/oauth/applications → uygulamanın "Access Key" değeri
UNSPLASH_ACCESS_KEY=
# Pexels (opsiyonel; yeni anahtar verilmesi şu an durdurulmuş): https://www.pexels.com/api/
PEXELS_API_KEY=
# Pixabay (telifsiz stok VİDEO klipleri, Reels için): https://pixabay.com/api/docs/ → giriş yapınca anahtar görünür
PIXABAY_API_KEY=

# OpenAI (OPSİYONEL — yapay zekâ atmosfer görselleri + yedek seslendirme)
OPENAI_API_KEY=
AI_BACKGROUNDS_ENABLED=false
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ElevenLabs (OPSİYONEL — Reels seslendirme; yoksa OpenAI sesi kullanılır)
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_v3

# Telegram — BotFather'dan. Yönetim botu (sadece yönetici); firma botları yönetim botundan bağlanır.
MANAGER_BOT_TOKEN=
# Eski tek-bot düzeni: yönetim + ilk firma aynı botta
TELEGRAM_BOT_TOKEN=
# Botun cevap vereceği tek kullanıcı (senin Telegram ID'n)
TELEGRAM_ADMIN_ID=

# Meta uygulaması (Instagram API with Instagram Login)
META_APP_ID=
META_APP_SECRET=

# Görsellerin herkese açık adresi (Instagram görseli buradan çeker)
PUBLIC_MEDIA_BASE_URL=https://ornek-alanadi.com/media

TIMEZONE=Europe/Istanbul

# Satış botunun tanıttığı ürün adı
SALES_BRAND=Social Autopilot

# Not: Her firmanın Instagram token'ı .env'de değil, veritabanında tutulur
# (otomatik yenilendiği için). İlk kurulumda CLI komutuyla girilecek.
